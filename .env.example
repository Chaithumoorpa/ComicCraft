# Required for real Gemini generation
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Hugging Face token for models that require authentication
HF_TOKEN=

# Current model defaults. Change if your account exposes different models.
GEMINI_OUTLINE_MODEL=gemini-3.8-flash
GEMINI_STORY_MODEL=gemini-3.1-pro-preview

# Use "placeholder" to test the entire app without downloading Stable Diffusion.
# Use "diffusers" for real AI illustrations.
IMAGE_PROVIDER=diffusers
IMAGE_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5
IMAGE_STEPS=20
IMAGE_WIDTH=512
IMAGE_HEIGHT=512
SEED=42

APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true
